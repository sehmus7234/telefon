{
  "name": "telefon",
  "version": "0.2.0",
  "description": "Telefon cihaz yönetimi ve yedekleme masaüstü uygulaması (Electron + React + TypeScript)",
  "main": "./out/main/index.js",
  "author": "patron",
  "license": "MIT",
  "homepage": "https://github.com/sehmus7234/telefon",
  "repository": {
    "type": "git",
    "url": "https://github.com/sehmus7234/telefon.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:inspect": "electron-vite dev --inspect=9229",
    "heap:check": "node scripts/heap-leak-check.mjs",
    "build": "electron-vite build",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@types/pdfkit": "^0.17.6",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^11.10.0",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "framer-motion": "^14.3.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "ts-jest": "^29.4.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
